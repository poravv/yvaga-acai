---
import { CONTACT, CATALOG } from "../data/catalog.js";
import "../styles/global.css";

const {
  // Title y description llevan la ciudad adelante: la competencia local no la usa
  // y son las búsquedas que realmente convierten ("açaí itauguá", "heladería itauguá").
  // Description bajo 155 caracteres para que Google no la corte.
  title = "Açaí y helados artesanales en Itauguá | Yvága Açai",
  description = "Heladería artesanal en Itauguá, camino a Pirayú. Açaí cremoso, helados y bowls frescos preparados al momento. Pedí por WhatsApp.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// og:image tiene que ser URL absoluta: los crawlers de WhatsApp/Facebook no resuelven rutas relativas.
const ogImage = new URL("/assets/og-cover.jpg", Astro.site).href;

// JSON-LD: negocio local de comida → mejora visibilidad en Google y motores de IA.
const menuSchema = CATALOG.map((c) => ({
  "@type": "MenuSection",
  name: c.name,
  hasMenuItem: c.items.map((it) => ({
    "@type": "MenuItem",
    name: it.name,
    ...(it.desc ? { description: it.desc } : {}),
    ...(it.price != null ? { offers: { "@type": "Offer", price: it.price, priceCurrency: "PYG" } } : {}),
  })),
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  name: "Yvága Açai",
  description,
  url: canonical,
  servesCuisine: ["Açaí", "Helados", "Postres"],
  priceRange: "₲₲",
  telephone: "+" + CONTACT.whatsapp,
  address: {
    "@type": "PostalAddress",
    streetAddress: CONTACT.streetAddress,
    addressLocality: CONTACT.addressLocality,
    addressRegion: CONTACT.addressRegion,
    addressCountry: "PY",
  },
  geo: { "@type": "GeoCoordinates", latitude: CONTACT.geo.lat, longitude: CONTACT.geo.lng },
  hasMap: CONTACT.mapUrl,
  sameAs: [CONTACT.instagram, CONTACT.facebook, CONTACT.tiktok].filter((u) => u && u !== "#"),
  openingHoursSpecification: CONTACT.hours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  hasMenu: { "@type": "Menu", hasMenuSection: menuSchema },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#240a36" />
    <link rel="icon" href="/favicon.png?v=2" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Verificación de dominio de Meta Business. Etiqueta estática: no carga scripts
         ni cookies. Tiene que estar en el HTML servido, no inyectada por JS. -->
    <meta name="facebook-domain-verification" content="6uer1qeofhz9sgks7kps5viglm7onw" />

    <meta property="og:title" content="Yvága Açai — Açaí y helados artesanales en Itauguá" />
    <meta property="og:description" content="Açaí cremoso, helados y bowls frescos preparados al momento, sobre el camino a Pirayú. Pedí por WhatsApp." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Yvága Açai" />
    <meta property="og:locale" content="es_PY" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Yvága Açai — açaí, helados y bowls frescos. Pedí por WhatsApp." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <div class="cursor-orb" aria-hidden="true"></div>

    <div class="cookie-bar" id="cookieBar" hidden>
      <p>
        Usamos almacenamiento local para recordar tu carrito y este aviso. No usamos cookies de
        seguimiento. <a href="/cookies/">Más info</a>.
      </p>
      <button type="button" id="cookieOk" class="btn btn-lima">Entendido</button>
    </div>

    <script>
      // Aviso de cookies: se muestra si no fue aceptado antes (almacenamiento local).
      (() => {
        const bar = document.getElementById("cookieBar");
        if (!bar) return;
        let ok = false;
        try { ok = localStorage.getItem("yvaga_cookie_ok") === "1"; } catch {}
        if (!ok) bar.hidden = false;
        document.getElementById("cookieOk")?.addEventListener("click", () => {
          try { localStorage.setItem("yvaga_cookie_ok", "1"); } catch {}
          bar.hidden = true;
        });
      })();
    </script>

    <script>
      // Círculo açaí que sigue al cursor con suavizado (solo en dispositivos con mouse).
      (() => {
        const orb = document.querySelector(".cursor-orb");
        if (!orb || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        let mx = innerWidth / 2, my = innerHeight / 2, ox = mx, oy = my, raf = null;
        const tick = () => {
          ox += (mx - ox) * 0.3; oy += (my - oy) * 0.3;
          orb.style.transform = `translate(${ox}px, ${oy}px) translate(-50%, -50%)`;
          if (Math.abs(mx - ox) > 0.1 || Math.abs(my - oy) > 0.1) raf = requestAnimationFrame(tick);
          else raf = null;
        };
        addEventListener("mousemove", (e) => {
          mx = e.clientX; my = e.clientY; orb.classList.add("on");
          if (!raf) raf = requestAnimationFrame(tick);
        }, { passive: true });
        document.addEventListener("mouseleave", () => orb.classList.remove("on"));
        addEventListener("mousedown", () => orb.classList.add("tap"));
        addEventListener("mouseup", () => orb.classList.remove("tap"));
        // Crece sobre elementos interactivos.
        document.addEventListener("mouseover", (e) => {
          orb.classList.toggle("hot", !!e.target.closest("a, button, .mtab, .cat, .pcard, .promo"));
        }, { passive: true });
      })();
    </script>

    <script>
      // Reveal-on-scroll global para todos los elementos .reveal (islas y estático).
      const reveal = () => {
        const els = document.querySelectorAll(".reveal:not(.in)");
        if (!("IntersectionObserver" in window)) {
          els.forEach((e) => e.classList.add("in"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((en) => {
              if (en.isIntersecting) {
                en.target.classList.add("in");
                io.unobserve(en.target);
              }
            }),
          { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((e) => io.observe(e));
      };
      // Reintenta tras hidratar las islas, para capturar su markup recién montado.
      reveal();
      window.addEventListener("load", reveal);
      setTimeout(reveal, 600);
    </script>
  </body>
</html>
