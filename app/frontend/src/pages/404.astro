---
import Base from "../layouts/Base.astro";
import { CONTACT } from "../data/catalog.js";
---

<Base title="Página no encontrada — Yvága Açai">
  <section
    class="hero"
    style="min-height:100svh;display:flex;align-items:center;justify-content:center;text-align:center;"
  >
    <div class="hero-blobs">
      <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
    </div>
    <div class="wrap" style="position:relative;z-index:3;">
      <span class="kicker on-dark" style="justify-content:center;">Error 404</span>
      <h1 style="font-size:clamp(56px,12vw,120px);margin:14px 0;">Uy… <span class="em">se derritió</span></h1>
      <p class="hero-sub" style="margin:0 auto 32px;">
        Esta página no existe o se movió. Volvé al inicio y armá tu pedido.
      </p>
      <div class="hero-cta" style="justify-content:center;">
        <a class="btn btn-lima" href="/">Volver al inicio</a>
        <a class="btn btn-wa" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">Pedir por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
